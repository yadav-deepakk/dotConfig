#!/bin/bash

eval "$(starship init zsh)"

export CLICOLOR=1
export EDITOR=/opt/homebrew/bin/vim

google(){ open -a Helium "https://www.google.com/search?q=${(j:+:)@}"; }
youtube(){ open -a Helium "https://www.youtube.com/results?search_query=${(j:+:)@}"; }
reddit(){ open -a Helium "https://www.reddit.com/search/?q=${(j:+:)@}"; }
redditr() {
  if [[ -z "$1" ]]; then
    return 1
  fi
  open -a Helium "https://www.reddit.com/r/${sub}/search/?q=${(j:+:)@}&restrict_sr=1"
}
googlet(){ open -a Helium "https://translate.google.com/?sl=auto&tl=hi&op=translate&text=${(j:+:)@}"; }
amazon(){ open -a Helium "https://www.amazon.in/s?k=${(j:+:)@}"; }
flipkart(){ open -a Helium "https://www.flipkart.com/search?marketplace=FLIPKART&as-show=on&as=off&q=${(j:+:)@}"; }

